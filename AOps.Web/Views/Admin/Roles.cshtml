@model RolesPageViewModel

@{
    ViewData["Title"] = "Roles Management";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<div class="container" style="min-height: 80vh;">
    <div class="row">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Add / Edit Role</h5>
                </div>
                <div class="card-body">
                    <form asp-action="CreateUserRoles" method="post" id="addRoleForm">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label asp-for="NewUser.Name" class="form-label">Name</label>
                            <input asp-for="NewUser.Name"  class="form-control" placeholder="Enter name" />
                            <span asp-validation-for="NewUser.Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewUser.Email" class="form-label">Email</label>
                            <input asp-for="NewUser.Email"  type="email" class="form-control" placeholder="Enter email" />
                            <span asp-validation-for="NewUser.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewUser.Role" class="form-label">Role</label>
                            <select asp-for="NewUser.Role"  class="form-select">
                                <option value="">-- Select Role --</option>
                                <option value="1">Admin</option>
                                <option value="2">Manager</option>
                                <option value="3">User</option>
                            </select>
                            <span asp-validation-for="NewUser.Role" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewUser.Mobile" class="form-label">Mobile</label>
                            <input asp-for="NewUser.Mobile"  class="form-control" placeholder="Enter mobile number" maxlength="10" />
                            <span asp-validation-for="NewUser.Mobile" class="text-danger"></span>
                        </div>

                        <div class="mb-3" id="PasswordField">
                            <label asp-for="NewUser.Password" class="form-label">Password</label>
                            <input asp-for="NewUser.Password"  type="password" class="form-control" placeholder="Enter password" min="4" />
                            <span asp-validation-for="NewUser.Password" class="text-danger"></span>
                        </div>

                        <input asp-for="NewUser.UserID"  type="hidden" />

                        <div class="d-flex justify-content-between mt-4">
                            <button type="reset" class="btn btn-secondary">Clear</button>
                            <button type="submit" class="btn btn-primary">Submit</button>
                        </div>

                        <div class="mt-3">
                            @Html.ValidationSummary(false, "", new { @class = "text-danger" })
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Table Section (70%) -->
        <div class="col-md-9">
            <table id="rolesTable" class="table table-bordered table-striped table-hover text-center">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Mobile</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.ExistingRoles.Any())
                    {
                        foreach (var item in Model.ExistingRoles)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Email</td>
                                <td>@item.RoleText</td>
                                <td>@item.Mobile</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>
                                <td>
                                    <a href="javascript:void(0)" onclick="loadUserForEdit('@item.UserID')" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a href="javascript:void(0)" onclick="openPasswordModal('@item.UserID')" class="btn btn-sm btn-outline-danger" title="passwrd">
                                        <i class="bi bi-key-fill"></i>
                                    </a>

                                    
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editUserModalLabel">Edit User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editUserForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="Orguser_UserID">

                    <div class="mb-3">
                        <label for="Orguser_Name" class="form-label">Name</label>
                        <input type="text" class="form-control" id="Orguser_Name">
                    </div>

                    <div class="mb-3">
                        <label for="Orguser_Email" class="form-label">Email</label>
                        <input type="text" class="form-control" id="Orguser_Email">
                    </div>

                    <div class="mb-3">
                        <label for="Orguser_Role" class="form-label">Role</label>
                        <select class="form-select" id="Orguser_Role">
                            <option value="">-- Select Role --</option>
                            <option value="1">Admin</option>
                            <option value="2">Manager</option>
                            <option value="3">User</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="Orguser_Mobile" class="form-label">Mobile</label>
                        <input type="text" class="form-control" id="Orguser_Mobile">
                    </div>

                    <div class="mb-3">
                        <label for="Orguser_IsActive" class="form-label">Status</label>
                        <select class="form-select" id="Orguser_IsActive">
                            <option value="false">Active</option>
                            <option value="true">Inactive</option>
                        </select>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary" form="editUserForm">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Change password Modal -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="changePasswordForm">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="changePasswordModalLabel">Change Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="ChangePassword_UserID" name="UserID">

                    <div class="mb-3">
                        <label for="NewPassword" class="form-label">New Password</label>
                        <input type="password" class="form-control" id="NewPassword" name="NewPassword" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- Add Role Modal -->


@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js//Admin/Roles.js"></script>
}


   



