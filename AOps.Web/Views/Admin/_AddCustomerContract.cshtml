@model AOps.Application.DTOs.CustomerContracts.AddCustomerContractDto
<div asp-validation-summary="All" class="text-danger"></div>
<div class="modal fade" id="addcustomerContractModal" tabindex="-1" aria-labelledby="addcustomerContractModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="AddCustomerContract" asp-controller="Admin" enctype="multipart/form-data" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addcustomerContractModalLabel">Add Client Contract</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CustomerId" class="form-label"></label>
                            <select asp-for="CustomerId" class="form-control" id="customerDropdown"
                                    asp-items="@(new SelectList(Model.CustomerList, "CustomerId", "CustomerName"))">
                                <option value="">-- Select Customers --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ContractType" class="form-label"></label>
                            <select asp-for="ContractType" id="ContractType" class="form-control select2">
                                <option value="">-- Select Contract Type --</option>
                                <option value="Vehicle">Vehicle</option>
                                <option value="Employee">Employee</option>
                            </select>
                            <span asp-validation-for="ContractType" class="text-danger"></span>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="StartDate" class="form-label"></label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="EndDate" class="form-label"></label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContractValue" class="form-label"></label>
                        <input asp-for="ContractValue" class="form-control" />
                        <span asp-validation-for="ContractValue" class="text-danger"></span>
                    </div>



                    <div class="row g-3" id="vehicleSection" style="display: none;">
                        <div class="col-md-6">
                            <label asp-for="VehiclesAgreed" class="form-label"></label>
                            <input asp-for="VehiclesAgreed" class="form-control" />
                            <span asp-validation-for="VehiclesAgreed" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="VehiclesUsed" class="form-label"></label>
                            <input asp-for="VehiclesUsed" class="form-control" />
                            <span asp-validation-for="VehiclesUsed" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row g-3" id="staffSection" style="display: none;">
                        <div class="col-md-6">
                            <label asp-for="StaffAgreed" class="form-label"></label>
                            <input asp-for="StaffAgreed" class="form-control" />
                            <span asp-validation-for="StaffAgreed" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StaffUsed" class="form-label"></label>
                            <input asp-for="StaffUsed" class="form-control" />
                            <span asp-validation-for="StaffUsed" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ContractDetails" class="form-label"></label>
                        <textarea asp-for="ContractDetails" class="form-control"></textarea>
                        <span asp-validation-for="ContractDetails" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="AgreementDocument" class="form-label">Agreement Document (Optional)</label>
                        <input asp-for="AgreementDocument" type="file" class="form-control" />
                        <span asp-validation-for="AgreementDocument" class="text-danger"></span>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Contract</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

}