@model AOps.Application.DTOs.CustomerSites.AddCustomerSiteDto

<!-- Modal -->
<div class="modal fade" id="addCustomerSiteModal" tabindex="-1" role="dialog" aria-labelledby="addCustomerSiteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addCustomerSiteLabel">Add Customer Site</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddCustomerSite" asp-controller="Admin" method="post">
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row">
                    <!-- Customer Dropdown -->
                        <div class="col-md-6 mb-3">
                        <label asp-for="CustomerId" class="form-label">Customer</label>
                        <select asp-for="CustomerId"
                                asp-items="@(new SelectList(Model.CustomerList ?? new(), "CustomerId", "CustomerName"))"
                                class="form-select">
                            <option value="">-- Select Customer --</option>
                        </select>
                        <span asp-validation-for="CustomerId" class="text-danger"></span>
                    </div>

                    <!-- Contract Dropdown -->
                        <div class="col-md-6 mb-3">
                        <label asp-for="CustomerContractId" class="form-label">Contract</label>
                        <select asp-for="CustomerContractId"
                                asp-items="@(new SelectList(Model.CustomerContract ?? new(), "Ccontractid", "Ccontractid"))"
                                class="form-select">
                            <option value="">-- Select Contract --</option>
                        </select>
                        <span asp-validation-for="CustomerContractId" class="text-danger"></span>
                    </div>
                    </div>
                    <!-- Site Details -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="SiteName" class="form-label">Site Name</label>
                            <input asp-for="SiteName" class="form-control" />
                            <span asp-validation-for="SiteName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SiteCity" class="form-label">City</label>
                            <input asp-for="SiteCity" class="form-control" />
                            <span asp-validation-for="SiteCity" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="SiteState" class="form-label">State</label>
                            <input asp-for="SiteState" class="form-control" />
                            <span asp-validation-for="SiteState" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="SiteZip" class="form-label">ZIP Code</label>
                            <input asp-for="SiteZip" class="form-control" />
                            <span asp-validation-for="SiteZip" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="SiteCountry" class="form-label">Country</label>
                            <input asp-for="SiteCountry" class="form-control" />
                            <span asp-validation-for="SiteCountry" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Vehicles Dropdown -->
                    <div class="mb-3">
                        <label asp-for="AssignedVehicleIds" class="form-label">Assign Vehicles</label>
                        <select asp-for="AssignedVehicleIds"
                                asp-items="@(new SelectList(Model.VehicleList ?? new(), "VehicleId", "VehicleNumber"))"
                                class="form-select select2"
                                multiple="multiple">
                        </select>
                        <span asp-validation-for="AssignedVehicleIds" class="text-danger"></span>
                    </div>

                    <!-- Employee Dropdown -->
                    <div class="mb-3">
                        <label asp-for="AssignedmployeeIds" class="form-label">Assign Employees</label>
                        <select asp-for="AssignedmployeeIds"
                                asp-items="@(new SelectList(Model.EmployeeSelectList ?? new(), "EmployeeId", "EmployeeName"))"
                                class="form-select select2"
                                multiple="multiple">
                        </select>
                        <span asp-validation-for="AssignedmployeeIds" class="text-danger"></span>
                    </div>


                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
                </div>
            </form>
        </div>
    </div>
</div>