@model AOps.Application.DTOs.Employees.AddEmployeesDto
@using AOps.Domain.Enums


<div asp-validation-summary="All" class="text-danger"></div>

<div class="modal fade" id="addemployeeModal" tabindex="-1" aria-labelledby="addemployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="AddEmployee" asp-controller="Admin" enctype="multipart/form-data" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addemployeeModalLabel">Add Employee</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label"></label>
                            <select asp-for="Gender" class="form-control">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>
                       
                    </div>

                    <div class="row mb-3">
                       
                        <div class="col-md-12">
                            <label asp-for="Address" class="form-label"></label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Designation" class="form-label"></label>
                            <select asp-for="Designation" class="form-control"
                                    asp-items="Html.GetEnumSelectList<Designation>()">
                                <option value="">-- Select Designation --</option>
                            </select>
                            <span asp-validation-for="Designation" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EmploymentType" class="form-label"></label>
                            <select asp-for="EmploymentType" class="form-control"
                                    asp-items="Html.GetEnumSelectList<EmploymentType>()">
                                <option value="">-- Select Employment Type --</option>
                            </select>
                            <span asp-validation-for="EmploymentType" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="GovDocumentFile" class="form-label">Government ID Document</label>
                        <input asp-for="GovDocumentFile" type="file" class="form-control" />
                        <span asp-validation-for="GovDocumentFile" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProfesionalDocumentFile" class="form-label">Professional ID Document</label>
                        <input asp-for="ProfesionalDocumentFile" type="file" class="form-control" />
                        <span asp-validation-for="ProfesionalDocumentFile" class="text-danger"></span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Employee</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
