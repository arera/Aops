@model AOps.Application.DTOs.EmpContract.AddEmployeeContractDto

<div asp-validation-summary="All" class="text-danger"></div>

<div class="modal fade" id="addEmployeeContractModal" tabindex="-1" aria-labelledby="addEmployeeContractModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="AddEmployeeContract" asp-controller="Admin" enctype="multipart/form-data" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="addEmployeeContractModalLabel">Add Employee Contract</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="EmployeeId" class="form-label">Employee</label>
                            <select asp-for="EmployeeId" class="form-control select2"
                                    asp-items="@(new SelectList(Model.EmployeeList, "EmployeeId", "EmployeeName"))">
                                <option value="">-- Select Employee --</option>
                            </select>
                            <span asp-validation-for="EmployeeId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="ContractStartDate" class="form-label">Start Date</label>
                            <input asp-for="ContractStartDate" type="date" class="form-control" />
                            <span asp-validation-for="ContractStartDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ContractEndDate" class="form-label">End Date</label>
                            <input asp-for="ContractEndDate" type="date" class="form-control" />
                            <span asp-validation-for="ContractEndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" placeholder="Enter contract description"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ContractDocument" class="form-label">Contract Document (Optional)</label>
                        <input asp-for="ContractDocument" type="file" class="form-control" />
                        <span asp-validation-for="ContractDocument" class="text-danger"></span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Contract</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
