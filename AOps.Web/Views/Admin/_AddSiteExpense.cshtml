@using AOps.Domain.Enums
@model AOps.Application.DTOs.Expense.AddExpenseDto

<div class="modal fade" id="addExpenseModal" tabindex="-1" aria-labelledby="addExpenseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="addExpenseModalLabel">Add Site Expense</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form id="addExpenseForm" asp-action="AddSiteExpense" asp-controller="Admin" method="post" enctype="multipart/form-data">
                    <div class="row g-3">

                        <!-- Site Dropdown -->
                        <div class="col-md-6">
                            <label asp-for="SiteId" class="form-label"></label>
                            <select asp-for="SiteId" class="form-select" asp-items="@(new SelectList(Model.SiteList, "SiteId", "SiteName"))">
                                <option value="">-- Select Site --</option>
                            </select>
                            <span asp-validation-for="SiteId" class="text-danger"></span>
                        </div>

                        <!-- Executive Dropdown -->
                        <div class="col-md-6">
                            <label asp-for="ExecutiveId" class="form-label"></label>
                            <select asp-for="ExecutiveId" class="form-select" asp-items="@(new SelectList(Model.ExecutiveList, "UserId", "UserName"))">
                                <option value="">-- Select Executive --</option>
                            </select>
                            <span asp-validation-for="ExecutiveId" class="text-danger"></span>
                        </div>

                        <!-- Expense Type -->
                        <div class="col-md-6">
                            <label asp-for="ExpenseType" class="form-label"></label>
                            <select asp-for="ExpenseType" class="form-select" asp-items="Html.GetEnumSelectList<ExpenseType>()">
                                <option value="">-- Select Expense Type --</option>
                            </select>
                            <span asp-validation-for="ExpenseType" class="text-danger"></span>
                        </div>

                        <!-- Amount -->
                        <div class="col-md-6">
                            <label asp-for="ExpenseAmount" class="form-label"></label>
                            <input asp-for="ExpenseAmount" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="ExpenseAmount" class="text-danger"></span>
                        </div>

                        <!-- Date -->
                        <div class="col-md-6">
                            <label asp-for="ExpenseDate" class="form-label"></label>
                            <input asp-for="ExpenseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpenseDate" class="text-danger"></span>
                        </div>

                        <!-- Remark -->
                        <div class="col-md-12">
                            <label asp-for="ExpenseRemark" class="form-label"></label>
                            <textarea asp-for="ExpenseRemark" class="form-control"></textarea>
                            <span asp-validation-for="ExpenseRemark" class="text-danger"></span>
                        </div>

                        <!-- File Upload -->
                        <div class="col-md-6">
                            <label asp-for="ReceiptDocumentFile" class="form-label"></label>
                            <input asp-for="ReceiptDocumentFile" class="form-control" type="file" />
                            <span asp-validation-for="ReceiptDocumentFile" class="text-danger"></span>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="addExpenseForm" class="btn btn-primary">Save Expense</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
