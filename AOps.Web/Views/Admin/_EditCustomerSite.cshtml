@model AOps.Application.DTOs.CustomerSites.EditCustomerSiteDto

<!-- Modal -->
<div class="modal fade" id="editCustomerSiteModal" tabindex="-1" role="dialog" aria-labelledby="editCustomerSiteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editCustomerSiteLabel">Edit Customer Site</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="UpdateCustomerSite" asp-controller="Admin" method="post">
                <input type="hidden" asp-for="SiteId" />

                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Customer + Contract -->
                    <div class="row">
                        <!-- Customer Dropdown -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="CustomerId" class="form-label">Customer</label>
                            <select asp-for="CustomerId"
                                    asp-items="@(new SelectList(Model.CustomerList ?? new(), "CustomerId", "CustomerName", Model.CustomerId))"
                                    class="form-select"
                                    id="CustomerId">
                                <option value="">-- Select Customer --</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger"></span>
                        </div>

                        <!-- Contract Dropdown -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="CustomerContractId" class="form-label">Contract</label>
                            <select asp-for="CustomerContractId"
                                    asp-items="@(new SelectList(Model.CustomerContract ?? new(), "Ccontractid", "Ccontractid", Model.CustomerContractId))"
                                    class="form-select"
                                    id="CustomerContractId">
                                <option value="">-- Select Contract --</option>
                            </select>
                            <span asp-validation-for="CustomerContractId" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Site Details -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="SiteName" class="form-label">Site Name</label>
                            <input asp-for="SiteName" class="form-control" />
                            <span asp-validation-for="SiteName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SiteCity" class="form-label">City</label>
                            <input asp-for="SiteCity" class="form-control" />
                            <span asp-validation-for="SiteCity" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="SiteState" class="form-label">State</label>
                            <input asp-for="SiteState" class="form-control" />
                            <span asp-validation-for="SiteState" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="SiteZip" class="form-label">ZIP Code</label>
                            <input asp-for="SiteZip" class="form-control" />
                            <span asp-validation-for="SiteZip" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="SiteCountry" class="form-label">Country</label>
                            <input asp-for="SiteCountry" class="form-control" />
                            <span asp-validation-for="SiteCountry" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Vehicles Dropdown -->
                    <div class="mb-3">
                        <label asp-for="AssignedVehicleIds" class="form-label">Assign Vehicles</label>
                        <select asp-for="AssignedVehicleIds"
                                asp-items="@(new SelectList(Model.VehicleList ?? new(), "VehicleId", "VehicleNumber", Model.AssignedVehicleIds))"
                                class="form-select select2"
                                id="AssignedVehicleIds"
                                multiple="multiple">
                        </select>
                        <span asp-validation-for="AssignedVehicleIds" class="text-danger"></span>
                    </div>

                    <!-- Employee Dropdown -->
                    <div class="mb-3">
                        <label asp-for="AssignedEmployeeIds" class="form-label">Assign Employees</label>
                        <select asp-for="AssignedEmployeeIds"
                                asp-items="@(new SelectList(Model.EmployeeSelectList ?? new(), "EmployeeId", "EmployeeName", Model.AssignedEmployeeIds))"
                                class="form-select select2"
                                id="AssignedEmployeeIds"
                                multiple="multiple">
                        </select>
                        <span asp-validation-for="AssignedEmployeeIds" class="text-danger"></span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</div>
