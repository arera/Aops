@model AOps.Application.DTOs.Vendor.EditVendorDto

<div class="modal fade" id="editVendorModal" tabindex="-1" aria-labelledby="editVendorModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="EditVendor" asp-controller="Admin" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="editVendorModalLabel">Edit Vendor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @* Hidden field for VendorId *@
                    <input asp-for="VendorId" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="VendorName" class="form-label"></label>
                        <input asp-for="VendorName" class="form-control" />
                        <span asp-validation-for="VendorName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="VendorMobile" class="form-label"></label>
                        <input asp-for="VendorMobile" class="form-control" />
                        <span asp-validation-for="VendorMobile" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="VendorEmail" class="form-label"></label>
                        <input asp-for="VendorEmail" class="form-control" />
                        <span asp-validation-for="VendorEmail" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="VendorAddress" class="form-label"></label>
                        <textarea asp-for="VendorAddress" class="form-control"></textarea>
                        <span asp-validation-for="VendorAddress" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="IsActive" class="form-label">Status</label>
                        <select asp-for="IsActive" class="form-select">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                        <span asp-validation-for="IsActive" class="text-danger"></span>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Update Vendor</button>
                </div>
            </form>
        </div>
    </div>
</div>
