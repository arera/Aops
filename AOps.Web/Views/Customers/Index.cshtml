@model AOps.Application.DTOs.CustomerDashboard.DashboardViewdto

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

<div class="container-fluid mt-4">
    <!-- ====== SUMMARY CARDS ====== -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-primary text-white">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-truck-front fs-1 me-3"></i>
                    <div>
                        <h6 class="text-uppercase mb-0">Total Vehicles</h6>
                        <h3 class="fw-bold mb-0">@Model.Vehicles?.Count()</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-success text-white">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-people-fill fs-1 me-3"></i>
                    <div>
                        <h6 class="text-uppercase mb-0">Total Employees</h6>
                        <h3 class="fw-bold mb-0">@Model.Employees?.Count()</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-warning text-dark">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle fs-1 me-3"></i>
                    <div>
                        <h6 class="text-uppercase mb-0">Expiring Documents (Next 30 Days)</h6>
                        <h3 class="fw-bold mb-0">
                            @{
                                var expiring = Model.Vehicles?.Count(v =>
                                v.PollutionCertificate <= DateTime.Now.AddDays(30) ||
                                v.Insurance <= DateTime.Now.AddDays(30) ||
                                v.FitnessCertificate <= DateTime.Now.AddDays(30)
                                );
                            }
                            @expiring
                        </h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 bg-info text-white">
                <div class="card-body d-flex align-items-center">
                    <i class="bi bi-geo-alt fs-1 me-3"></i>
                    <div>
                        <h6 class="text-uppercase mb-0">Active Sites</h6>
                        <h3 class="fw-bold mb-0">
                            @(Model.Vehicles?.Select(v => v.SiteName).Distinct().Count())
                        </h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ====== MAIN CONTENT ====== -->
    <div class="row g-4">
        <!-- LEFT COLUMN: VEHICLES (60%) -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header text-white fw-semibold"
                     style="background: linear-gradient(90deg, #007bff, #6610f2); color: #fff !important;">
                    <h4 class="mb-0"><i class="bi bi-truck-front me-2"></i>Vehicles Overview</h4>
                </div>

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="text-center">
                                    <th>Site Name</th>
                                    <th>Vehicle</th>
                                    <th>Pollution</th>
                                    <th>Insurance</th>
                                    <th>Fitness</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Vehicles != null && Model.Vehicles.Any())
                                {
                                    foreach (var v in Model.Vehicles)
                                    {
                                        <tr class="text-center">
                                            <td>@v.SiteName</td>
                                            <td class="fw-semibold text-primary">@v.VehicleName</td>
                                            <td>@v.PollutionCertificate.ToString("dd-MMM-yyyy")</td>
                                            <td>@v.Insurance.ToString("dd-MMM-yyyy")</td>
                                            <td>@v.FitnessCertificate.ToString("dd-MMM-yyyy")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-muted py-4">No vehicles found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: EMPLOYEES (40%) -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header text-white fw-semibold"
                     style="background: linear-gradient(90deg, #28a745, #20c997); color: #fff !important;">
                    <h4 class="mb-0"><i class="bi bi-people-fill me-2"></i>Employees Overview</h4>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="text-center">
                                    <th>Site Name</th>
                                    <th>Name</th>
                                    <th>Designation</th>
                                    <th>Gender</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Employees != null && Model.Employees.Any())
                                {
                                    foreach (var emp in Model.Employees)
                                    {
                                        <tr class="text-center">
                                            <td>@emp.SiteName</td>
                                            <td class="fw-semibold">@emp.EmpName</td>
                                            <td>@emp.Designation</td>
                                            <td>@emp.Gender</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-4">No employees found</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
