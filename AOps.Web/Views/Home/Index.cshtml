@model AOps.Application.DTOs.CustomerLogins.LoginRequestDto
@{
    ViewData["Title"] = "Login";
}

<div class="d-flex justify-content-center align-items-center" style="min-height:80vh; background:#f8fafc;">
    <div class="login-card p-4 shadow-lg rounded-4"
         style="max-width:420px; width:100%;
            background: linear-gradient(135deg, #f9fafc 0%, #e8f0fe 100%);
            border: none; box-shadow: 0 6px 20px rgba(0,0,0,0.1);">
        <!-- Title -->
        <h2 class="text-center fw-bold text-dark mb-2">Sign in to <span class="text-primary">VMEDO-OPS</span></h2>
        <p class="text-center text-muted mb-4" style="font-size: 0.9rem;">
            Your smart way to manage operations 🚀
        </p>

        <form asp-action="CustomerLogin" asp-controller="Auth" method="post">
            @Html.AntiForgeryToken()

            <!-- Email -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                <input asp-for="Email" class="form-control rounded-3" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold">Password</label>
                <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <!-- Login Button -->
            <button type="submit" id="loginBtn" class="btn btn-primary w-100 rounded-pill fw-semibold shadow-sm">
                <span id="btnText">Login</span>
                <span id="btnLoader" class="spinner-border spinner-border-sm ms-2 d-none" role="status" aria-hidden="true"></span>
            </button>

        </form>
    </div>

</div>
@section Scripts {
    <script>
        $("form").on("submit", function () {
            let messages = [
                "Signing you in...",
                "Securing your account...",
                "Verifying credentials...",
                "Almost there..."
            ];

            let index = 0;
            $("#loginBtn").prop("disabled", true);
            $("#loader").removeClass("d-none");
            $("#btnText").text(messages[index]);

            let interval = setInterval(function () {
                index++;
                if (index < messages.length) {
                    $("#btnText").text(messages[index]);
                } else {
                    clearInterval(interval); // stop when done
                }
            }, 2000); // change text every 2 seconds
        });
    </script>


}

