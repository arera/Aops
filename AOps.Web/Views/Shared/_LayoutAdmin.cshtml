<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] VMEDO</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AOps.Web.styles.css" asp-append-version="true" />
    @using Microsoft.AspNetCore.Http
    @inject IHttpContextAccessor HttpContextAccessor
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm" style="background: linear-gradient(to right, #0f2027, #203a43, #2c5364);">
            <div class="container-fluid">
                <!-- Logo -->
                <span class="navbar-brand h1 fw-bold text-white mb-0">LOGO</span>

                <!-- Toggler -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Nav Links -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <!-- Dashboard -->
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Admin" asp-action="Dashboards">Dashboard</a>
                        </li>

                        <!-- Admin -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Admin
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="adminDropdown">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Roles">Roles</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Customers">Customers</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="SiteExpense">Site Expense</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="AoeSiteMapping">AOE Mapping</a></li>
                            </ul>
                        </li>

                        <!-- Customer -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="customerDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Customer
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="customerDropdown">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="CustomerContract">Customer Contract</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="CustomerSite">Customer Site</a></li>
                            </ul>
                        </li>

                        <!-- Vendor -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="vendorDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Vendor
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="vendorDropdown">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Vendor">Vendor</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="VendorContract">Vendor Contract</a></li>
                            </ul>
                        </li>

                        <!-- Vehicle -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="vehicleDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Vehicle
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="vehicleDropdown">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Vehicle">Vehicle</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="VehicleDocument">Vehicle Documents</a></li>
                            </ul>
                        </li>
                        <!-- Employee -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="vehicleDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Employee
                            </a>
                            <ul class="dropdown-menu shadow" aria-labelledby="employeeDropdown">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Employee">Employee</a></li>
                                @* <li><a class="dropdown-item" asp-controller="Admin" asp-action="SiteEmployee">Contracts</a></li> *@
                            </ul>
                        </li>

                        <!-- Ticket -->
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Admin" asp-action="ServiceTickets">Tickets</a>
                        </li>
                    </ul>

                    <!-- Profile Dropdown -->
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @HttpContextAccessor.HttpContext.Session.GetString("Role")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                                <li>
                                    <span class="dropdown-item-text fw-semibold">
                                        Hello, @HttpContextAccessor.HttpContext.Session.GetString("Name")
                                    </span>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Admin" asp-action="ChangePassword">
                                        <i class="bi bi-lock me-2"></i> Change Password
                                    </a>
                                </li>
                                <li>
                                    <form method="post" asp-controller="Auth" asp-action="Logout" class="d-inline">
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>

            </div>
        </nav>
    </header>


    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - Vmedo - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
   @*  <script src="~/lib/jquery/dist/jquery.min.js"></script> *@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
